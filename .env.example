# Environment
ENVIRONMENT=dev
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5068

# Database (PostgreSQL) — read/write split; point both at the same DB for local dev
WRITE_CONNECTION_STRING=Host=localhost;Port=5433;Database=learnflow;Username=learnflow;Password=learnflow
READ_CONNECTION_STRING=Host=localhost;Port=5433;Database=learnflow;Username=learnflow;Password=learnflow

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=learnflow-service
JWT_AUDIENCE=learnflow-clients
JWT_EXPIRY_HOURS=8

# Firebase (optional — service runs without it)
FIREBASE_API_KEY=
FIREBASE_CREDENTIAL_PATH=prod_firebase.json

# Grafana Loki logging (optional — falls back to console)
LOKI_URL=
LOKI_USER=
LOKI_API_KEY=
